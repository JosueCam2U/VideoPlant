# Database (RDS)
DATABASE_URL=postgresql://user:password@rds-endpoint:5432/videosdb

# JWT
SECRET_KEY=change-me-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AWS
AWS_REGION=us-east-1
S3_BUCKET_VIDEOS=my-videos-bucket
S3_BUCKET_THUMBNAILS=my-thumbnails-bucket
# En EC2 con IAM Role NO necesitas credenciales.
# Solo para desarrollo local:
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx

# App
ALLOWED_ORIGINS=http://localhost:5173,http://my-frontend-bucket.s3-website-us-east-1.amazonaws.com